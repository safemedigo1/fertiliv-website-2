# Names only. Put real values in .env locally and in Vercel. Never commit secrets.

# Supabase. DATABASE_URL is the transaction pooler (port 6543).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_PASSWORD=
DATABASE_URL=
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=
SUPABASE_DB_USER=

# Scheduled jobs. Sign-in is Supabase Auth (the three Supabase variables above).
# JWT_SECRET remains for external-report proofs, not for clinic sessions.
JWT_SECRET=
CRON_SECRET=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Email and Google Calendar
RESEND_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_OAUTH_TOKEN_ENCRYPTION_KEY=

# AI
GROQ_LLM_API_KEY=
GROQ_WHISPER_API_KEY=

# WhatsApp through Zernio
ZERNIO_API_KEY=
ZERNIO_WEBHOOK_SECRET=
WHATSAPP_CREDENTIAL_ENCRYPTION_KEY=

# Optional
OWNER_EMAIL=
SENTRY_DSN=
